}
class ExportadorExcel <<bridge>> implements ExportadorFormato {
+ exportar(titulo: String, datos: Map) : bool
}
class ExportadorPDF <<bridge>> implements ExportadorFormato {
+ exportar(titulo: String, datos: Map) : bool
}

abstract class Reporte <<entidad>> <<bridge>> {
# formatoExportacion : ExportadorFormato
--
+ {abstract} generar() : void
