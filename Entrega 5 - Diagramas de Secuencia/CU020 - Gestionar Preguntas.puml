@startuml CU020_GestionarPreguntas

actor Consultor
boundary "Pantalla\nGestión Preguntas" as PANT
control "Gestor\nPreguntas" as GES
database "Pregunta\nDAO" as DAO

Consultor -> PANT : Selecciona la opción "Preguntas" del menú
PANT --> Consultor : Muestra la pantalla de búsqueda\n(Competencia, Factor y Nombre de Pregunta)

loop mientras el actor no presione "Salir"

  alt El actor presiona "Nuevo" sin haber buscado ninguna pregunta

    Consultor -> PANT : Presiona "Nuevo"
    note over PANT, DAO : Se invoca el CU021 - Dar de alta Pregunta
    PANT --> Consultor : Actualiza la grilla

  else El actor presiona "Buscar" sin ingresar ningún criterio

    Consultor -> PANT : Presiona "Buscar"
    PANT -> PANT : validarCriterios()
    PANT --> Consultor : "Debe ingresar al menos un criterio de búsqueda"
    note right of PANT : Vuelve a la pantalla de búsqueda

  else El actor ingresa al menos un criterio y presiona "Buscar"

    Consultor -> PANT : Ingresa los criterios (Competencia, Factor\ny/o Nombre) y presiona "Buscar"
    PANT -> PANT : validarCriterios()
    PANT -> GES : buscarPreguntas(filtros)
    GES -> DAO : buscarPorCriterios(idCompetencia, idFactor, nombre)
    DAO --> GES : preguntas
    GES --> PANT : listaPreguntasDTO

    note right of DAO
      Una sola consulta con todos los criterios:
      0 o vacío = sin ese filtro. El nombre se
      busca con criterio "contiene", así también
      se puede buscar solo por nombre.
    end note

    alt No hay preguntas que cumplan los criterios
      PANT --> Consultor : "No se encontraron preguntas con los criterios ingresados"
    else Hay preguntas
      PANT --> Consultor : Muestra la grilla con Competencia,\nFactor y Pregunta
    end

    alt El actor selecciona una pregunta y presiona "Modificar"

      Consultor -> PANT : Selecciona una pregunta y presiona "Modificar"
      note over PANT, DAO : Se invoca el CU022 - Modificar Pregunta
      PANT --> Consultor : Actualiza la grilla

    else El actor selecciona una pregunta y presiona "Eliminar"

      Consultor -> PANT : Selecciona una pregunta y presiona "Eliminar"
      note over PANT, DAO : Se invoca el CU023 - Dar de baja Pregunta
      PANT --> Consultor : Actualiza la grilla

    end

  end

end

Consultor -> PANT : Presiona "Salir"
PANT --> Consultor : Vuelve a la pantalla principal

@enduml
