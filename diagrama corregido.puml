' ============================================================
' RELACIONES ENTRE ENTIDADES DEL DOMINIO Y PATRÓN STATE
' ============================================================
Candidato --> TipoDocumento
Candidato --> Genero
Empresa "1" --> "*" Puesto
Empresa "1" --> "*" Consultor
Puesto "1" *-- "*" CaracteristicaPuesto
CaracteristicaPuesto "*" --> "1" Competencia
Competencia "1" *-- "*" Factor
Competencia --> TipoCompetencia
Factor "1" *-- "*" Pregunta
OpcionDeRespuesta "1" *-- "*" ItemOpcionDeRespuesta
Pregunta "*" --> "1" OpcionDeRespuesta
Pregunta "1" *-- "*" PonderacionItem
PonderacionItem "*" --> "1" ItemOpcionDeRespuesta
Evaluacion "*" --> "1" Puesto
Evaluacion "*" --> "1" Consultor
Evaluacion "1" *-- "*" Cuestionario
Cuestionario "*" --> "1" Candidato
Cuestionario "1" *-- "1" EstadoCuestionarioState : estadoActual
Cuestionario "1" *-- "*" PreguntaCuestionario
Cuestionario "1" *-- "*" ResultadoCompetencia
PreguntaCuestionario "*" --> "1" Pregunta
PreguntaCuestionario "1" --> "0..1" RespuestaCandidata
RespuestaCandidata "*" --> "1" ItemOpcionDeRespuesta
ResultadoCompetencia --> Competencia
ResultadoCompetencia "1" *-- "*" ResultadoFactor
ResultadoFactor --> Factor
OrdenMerito "1" *-- "*" ItemOrdenMerito
ItemOrdenMerito --> Cuestionario
ReporteComparativo --> Cuestionario
ReporteComparativo --> CaracteristicaPuesto

