' ============================================================
' PATRÓN FACADE (Fachada para Subsistemas Externos)
' ============================================================
interface IAutenticacionLDAP <<interfaz>> {
+ autenticar(usuario: String, password: String) : Consultor
+ validarSesion(token: String) : bool
}
interface IImportadorCandidatos <<interfaz>> {
+ importar(rutaArchivo: String) : ResultadoImport
+ validarFormato(rutaArchivo: String) : bool
}
interface IExportadorResultados <<interfaz>> {
+ exportarCSV(puesto: Puesto, salida: OutputStream) : bool
+ exportarExcel(titulo: String, candidatos: List<CandidatoCuestionarioDTO>, salida: OutputStream) : bool
}
interface IServicioIA <<interfaz>> {
+ generarPregunta(competencia: Competencia, factor: Factor) : Pregunta
+ generarPuesto(nombre: String) : Puesto
}

class ServiciosExternosFacade <<facade>> {
- authLDAP : IAutenticacionLDAP
- servicioIA : IServicioIA
- importador : IImportadorCandidatos
- exportador : IExportadorResultados
--
+ autenticarConsultor(usr: String, pass: String) : Consultor
+ generarPreguntaIA(comp: Competencia, factor: Factor) : Pregunta
+ importarCandidatos(ruta: String) : ResultadoImport
+ exportarResultados(titulo: String, formato: String, candidatos: List<CandidatoCuestionarioDTO>, salida: OutputStream) : bool
}

ServiciosExternosFacade ..> IAutenticacionLDAP : usa
ServiciosExternosFacade ..> IServicioIA : usa
ServiciosExternosFacade ..> IImportadorCandidatos : usa
ServiciosExternosFacade ..> IExportadorResultados : usa

' Implementaciones de los subsistemas externos usadas en el TP
class AutenticacionLDAPSimulada <<facade>> implements IAutenticacionLDAP {
- consultorDAO : ConsultorDAO
--
+ autenticar(usuario: String, password: String) : Consultor
+ validarSesion(token: String) : bool
}
class ServicioIANoDisponible <<facade>> implements IServicioIA {
+ generarPregunta(competencia: Competencia, factor: Factor) : Pregunta
+ generarPuesto(nombre: String) : Puesto
}
class ImportadorCandidatosNoImplementado <<facade>> implements IImportadorCandidatos {
+ importar(rutaArchivo: String) : ResultadoImport
+ validarFormato(rutaArchivo: String) : bool
}
class ExportadorResultadosArchivo <<facade>> implements IExportadorResultados {
+ exportarCSV(puesto: Puesto, salida: OutputStream) : bool
+ exportarExcel(titulo: String, candidatos: List<CandidatoCuestionarioDTO>, salida: OutputStream) : bool
}
note bottom of ServicioIANoDisponible
  El LDAP está simulado contra la tabla de consultores y
  el servicio de IA siempre responde "no disponible"
  (lanza ServicioExternoException, mensaje del CU021).
  El importador (CU006) y exportarCSV (CU007) están fuera
  del alcance de las Etapas 7 y 8.
end note
AutenticacionLDAPSimulada ..> ConsultorDAO : usa

