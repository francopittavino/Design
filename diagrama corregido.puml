' ============================================================
' PATRÓN STATE (Ciclo de Vida de Cuestionario)
' ============================================================
interface EstadoCuestionarioState <<interfaz>> <<state>> {
+ responder(c: Cuestionario, resp: Map<Integer, Integer>) : void
+ finalizar(c: Cuestionario) : void
+ verificarTiempo(c: Cuestionario) : bool
+ getNombreEstado() : String
+ {static} desdeNombre(nombre: String) : EstadoCuestionarioState
}

class EstadoActivo <<entidad>> <<state>> implements EstadoCuestionarioState {
+ responder(c: Cuestionario, resp: Map<Integer, Integer>) : void
+ finalizar(c: Cuestionario) : void
+ verificarTiempo(c: Cuestionario) : bool
+ getNombreEstado() : String
}
class EstadoEnProceso <<entidad>> <<state>> implements EstadoCuestionarioState {
+ responder(c: Cuestionario, resp: Map<Integer, Integer>) : void
+ finalizar(c: Cuestionario) : void
+ verificarTiempo(c: Cuestionario) : bool
+ getNombreEstado() : String
}
abstract class EstadoFinal <<entidad>> <<state>> implements EstadoCuestionarioState {
+ responder(c: Cuestionario, resp: Map<Integer, Integer>) : void
+ finalizar(c: Cuestionario) : void
+ verificarTiempo(c: Cuestionario) : bool
}
note bottom of EstadoFinal
  Completo, Incompleto y Sin Contestar comparten el comportamiento:
  no se puede responder ni finalizar, y el tiempo ya no corre.
end note
class EstadoCompleto <<entidad>> <<state>> extends EstadoFinal {
+ getNombreEstado() : String
}
class EstadoIncompleto <<entidad>> <<state>> extends EstadoFinal {
+ getNombreEstado() : String
}
class EstadoSinContestar <<entidad>> <<state>> extends EstadoFinal {
+ getNombreEstado() : String
}

' ============================================================
' DATA ACCESS OBJECTS (DAOs) - Acceso a datos
' ============================================================
interface CandidatoDAO <<interfaz>> <<dao>> {
+ importar(candidatos: List<Candidato>) : void
+ buscarPorId(id: int) : Candidato
+ buscarPorNroCandidato(nro: String) : Candidato
+ buscarPorDocumento(tipo: String, nro: String) : Candidato
+ buscarPorCriterios(apellido: String, nombre: String, nro: String) : List<Candidato>
+ guardar(c: Candidato) : void
+ actualizarClaveAcceso(nroCandidato: String, clave: String) : void
}
class CandidatoDAOImpl <<dao>> {}
CandidatoDAO <|.. CandidatoDAOImpl

interface PuestoDAO <<interfaz>> <<dao>> {
+ buscarPorId(id: int) : Puesto
+ buscarPorFiltros(filtros: Map<String, String>) : List<Puesto>
+ guardar(puesto: Puesto) : void
+ actualizar(puesto: Puesto) : void
+ eliminarLogico(id: int) : void
+ buscarCaracteristicas(idPuesto: int) : List<CaracteristicaPuesto>
+ existePuestoConCompetencia(idCompetencia: int) : bool
+ contarCandidatos(idPuesto: int) : int
+ contarEvaluacionesCompletas(idPuesto: int) : int
}
note bottom of PuestoDAO
  CaracteristicaPuesto es la relación N:M Puesto-Competencia
  con atributo (ponderacionMinima). No tiene DAO propio:
  guardar/actualizar persisten el puesto junto con sus
  características en la misma transacción.
end note
class PuestoDAOImpl <<dao>> {}
PuestoDAO <|.. PuestoDAOImpl

interface CompetenciaDAO <<interfaz>> <<dao>> {
+ buscarPorId(id: int) : Competencia
+ listarTodas() : List<Competencia>
+ buscarPorNombre(nombre: String) : List<Competencia>
+ guardar(comp: Competencia) : void
+ actualizar(comp: Competencia) : void
+ eliminarLogico(id: int) : void
}
class CompetenciaDAOImpl <<dao>> {}
CompetenciaDAO <|.. CompetenciaDAOImpl

interface FactorDAO <<interfaz>> <<dao>> {
+ buscarPorId(id: int) : Factor
+ buscarPorCompetencia(idComp: int) : List<Factor>
+ listarTodos() : List<Factor>
+ guardar(factor: Factor) : void
+ actualizar(factor: Factor) : void
+ eliminarLogico(id: int) : void
}
class FactorDAOImpl <<dao>> {}
FactorDAO <|.. FactorDAOImpl

interface PreguntaDAO <<interfaz>> <<dao>> {
+ buscarPorId(id: int) : Pregunta
+ buscarPorFactor(idFactor: int) : List<Pregunta>
+ buscarPorCriterios(idCompetencia: int, idFactor: int, nombre: String) : List<Pregunta>
+ guardar(pregunta: Pregunta) : void
+ actualizar(pregunta: Pregunta) : void
+ eliminarLogico(id: int) : void
+ buscarPonderaciones(idPregunta: int) : List<PonderacionItem>
+ existePreguntaConOpcion(idOpcion: int) : bool
}
note bottom of PreguntaDAO
  PonderacionItem es la relación N:M Pregunta-ItemOpcionDeRespuesta
  con atributo (valor). No tiene DAO propio:
  guardar/actualizar persisten la pregunta junto con sus
  ponderaciones en la misma transacción.
end note
class PreguntaDAOImpl <<dao>> {}
PreguntaDAO <|.. PreguntaDAOImpl

interface OpcionRespuestaDAO <<interfaz>> <<dao>> {
+ buscarPorId(id: int) : OpcionDeRespuesta
+ listarTodas() : List<OpcionDeRespuesta>
